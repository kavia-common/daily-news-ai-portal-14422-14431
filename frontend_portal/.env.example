# PUBLIC INTERFACE
# Environment variables required by the frontend portal for external APIs

# News API key for fetching live political news.
# Supported providers in this code:
# - NEWS_API_ORG (https://newsapi.org) -> use as REACT_APP_NEWS_API_KEY (top-headlines, country, category)
# - GNEWS (https://gnews.io) -> use as REACT_APP_GNEWS_API_KEY (fallback/demo-friendly)
# Provide at least one of these keys.
REACT_APP_NEWS_API_KEY=
REACT_APP_GNEWS_API_KEY=

# OpenWeatherMap API key for weather by coordinates.
# Sign up at https://openweathermap.org/ and create an API key, then put it here.
REACT_APP_OPENWEATHER_API_KEY=

# Environment variables for frontend_portal

# News providers (use at least one)
# Obtain from https://newsapi.org/
REACT_APP_NEWS_API_KEY=
# Optional fallback provider https://gnews.io/
REACT_APP_GNEWS_API_KEY=

# Weather (for WeatherWidget)
# Obtain from https://openweathermap.org/api
REACT_APP_OPENWEATHER_API_KEY=
